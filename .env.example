# ---------------------------------------------------------------------------
# NaihatiKaliParikrama — environment variables
# Copy to .env.local for local development, and set the same names in
# Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (Neon dashboard → Connect → pooled connection).
# Leave empty and the app still runs: it falls back to the bundled seed data in
# src/data/ and keeps crowd reports in memory for the life of the server process.
DATABASE_URL=

# Password for the /admin pandal editor. Any long random string.
# Without it the admin editor stays locked.
ADMIN_PASSWORD=

# Optional. Public so it is safe in the client bundle.
# Set to "1" to show the "sample data" warning banner while you are still
# replacing the seeded pandal names and pins.
NEXT_PUBLIC_SAMPLE_DATA=1

# Optional tile source override. Defaults to OpenStreetMap standard tiles.
# Example for a keyed provider: https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=XXXX
NEXT_PUBLIC_TILE_URL=

# Optional attribution line to accompany NEXT_PUBLIC_TILE_URL.
NEXT_PUBLIC_TILE_ATTRIBUTION=
